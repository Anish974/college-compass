generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id          String     @id
  name        String
  lat         Float
  lng         Float
  hubName     String
  hubLat      Float
  hubLng      Float
  colleges    College[]
  transits    Transit[]
  landmarks   Landmark[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model College {
  id              String      @id
  name            String
  shortName       String
  instituteCode   String?
  tier            Int?
  avgPackage      Float?
  highestPackage  Float?
  topRecruiters   Json?
  annualFee       Int?
  feeType         String?
  status          String?
  autonomy        String?
  university      String?
  address         String?
  district        String?
  lat             Float?
  lng             Float?
  website         String?
  cityId          String
  city            City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  courses         Course[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([cityId])
  @@index([instituteCode])
  @@index([tier])
}

model Course {
  id          String   @id @default(cuid())
  choiceCode  String
  name        String
  branch      String?
  intake      Int?
  cutoffsJson Json?
  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([branch])
}

model Transit {
  id        String   @id
  name      String
  type      String   // "railway" | "bus"
  lat       Float
  lng       Float
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
}

model Landmark {
  id        String   @id
  name      String
  lat       Float
  lng       Float
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}